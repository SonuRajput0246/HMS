## Multi-tenancy
## Base domain tenant subdomains hang off in production, e.g. hms.example.com
## so that acme.hms.example.com resolves to tenant "acme". Leave blank in
## development: the API and the app are on different origins locally, so the
## tenant arrives in the header below instead.
TENANT_BASE_DOMAIN=
TENANT_HEADER_NAME=X-Tenant

## Platform console (super admin)
##
## A DIFFERENT signing key from JWT_SECRET_KEY above. A token minted for a hotel
## must never verify on a platform route, and this is what guarantees it -- the
## `scope: "super_admin"` claim is only the second line of defence.
##
## Blank by default on purpose: with it unset, every platform route refuses the
## call loudly rather than degrading into "any token is fine".
PLATFORM_JWT_SECRET_KEY=
PLATFORM_JWT_ALGO=HS256
PLATFORM_JWT_EXPIRES_MIN=60

## How long a platform console session lasts, and how hard sign-in pushes back.
## MFA is compulsory for platform administrators, so this is the whole session
## lifetime -- there is no refresh cookie on this side.
SUPER_ADMIN_TOKEN_EXPIRES_MIN=60
SUPER_ADMIN_MAX_LOGIN_ATTEMPTS=5
SUPER_ADMIN_LOCKOUT_MINUTES=15

## Bootstrap operator, seeded by src/database/seeders/platform_admin_seeder.py.
## The defaults exist so a fresh database is reachable at all. CHANGE THEM before
## anything is exposed -- an install left on these is an install anyone can sign
## into. Password rules are 6-20 characters.
PLATFORM_ADMIN_EMAIL=platform@admin.local
PLATFORM_ADMIN_PASSWORD=Platform@123
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Admin

## The public origin this deployment is reached at. Handed to the platform
## console by GET /api/v1/platform/config so one build serves every environment
## and the panel can never print a development host in production.
PUBLIC_BASE_URL=http://localhost:4200